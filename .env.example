# Copy to .env.local for local development; set these in Vercel for deployment.
# Never put the real API key in dist/ or commit it to Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=low
# For models that support a thinking budget, a nonempty budget overrides level.
GEMINI_THINKING_BUDGET=
